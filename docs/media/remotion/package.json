{
  "name": "phone-mcp-launch-remotion",
  "version": "1.0.0",
  "description": "Editable continuous-world Phone MCP launch film",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mirochill/Phone-MCP.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "private": true,
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@remotion/cli": "4.0.537",
    "@remotion/media": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.ts PhoneMCP-Launch ../phone-mcp-launch.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "build": "remotion bundle"
  },
  "allowScripts": {
    "esbuild": false
  }
}
